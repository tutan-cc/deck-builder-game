theme_override_colors/font_color = Color(0.92, 0.9, 0.85, 1)
theme_override_constants/line_spacing = -1
theme_override_font_sizes/font_size = 12
text = "1. 左上角=花费；能量不够时卡会变暗
2. 拖到敌人=攻击，拖到空地=防御
3. 敌人头顶数字=它这回合的行动
4. 伤害先扣护盾，护盾每回合清零
5. 能量用完只能点「结束」，下回合回满
6. 一轮=你出牌 → 敌人行动 → 再轮到你
7. 易伤×1.5　力量+N　虚弱×0.75"
autowrap_mode = 2

